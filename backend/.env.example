# --- Server ---
NODE_ENV=development
PORT=3000

# --- JWT ---
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-string-at-least-32-bytes
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- Database ---
DATABASE_PATH=./data/invoice-insights.db

# --- Azure AI Foundry (GPT-4o) ---
# Azure OpenAI resource endpoint (format: https://<resource>.openai.azure.com/)
AZURE_AI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_AI_API_KEY=your-azure-api-key
AZURE_AI_DEPLOYMENT=gpt-4o
AZURE_AI_API_VERSION=2024-08-01-preview

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# --- CORS ---
# Comma-separated list of allowed origins, or * for development only.
# REQUIRED in production: must be set to a specific origin — wildcard * is rejected at startup.
# Example: CORS_ORIGIN=https://app.example.com,https://www.example.com
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Rate limiting ---
UPLOAD_RATE_LIMIT=10        # max upload requests per user per 60 s (default 10)
GENERAL_RATE_LIMIT_MAX=100  # max requests per IP per 15 min, all routes (default 100)
